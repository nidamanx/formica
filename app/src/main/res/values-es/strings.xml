    <!-- About -->
    <string name="about_title">Información</string>
    <string name="about_version">Versión %1$s</string>
    <string name="about_how_title">Cómo funciona</string>
    <string name="about_how_text">Formica gestiona la despensa y la lista de la compra de casa: qué tienes, dónde está, cuándo caduca y qué volver a comprar. También se ocupa de los productos caseros y de los comprados a productores.</string>
    <string name="about_family_title">En familia</string>
    <string name="about_family_text">Para usarla en varios teléfonos, exporta un archivo y ábrelo en el otro teléfono: Formica combina los datos de los dos teléfonos. Antes de cada importación guarda una copia, que puedes restaurar.</string>
    <string name="about_name_title">El nombre</string>
    <string name="about_name_text">Formica significa hormiga en latín, como en italiano: las hormigas están entre los seres vivos que hacen las mejores despensas.</string>
    <string name="about_privacy_title">Privacidad</string>
    <string name="about_privacy_text">Sin acceso a internet, sin cuenta, sin recogida de datos, sin publicidad ni rastreadores. Tus datos se quedan en el teléfono y están excluidos de las copias de seguridad de Android: solo salen con una exportación que inicias tú.</string>
    <string name="about_permissions_title">Permisos</string>
    <string name="about_perm_notifications">Notificaciones: para el aviso diario de caducidades.</string>
    <string name="about_perm_boot">Ejecutar al iniciar: para volver a programar el aviso después de reiniciar el teléfono.</string>
    <string name="about_perm_wake_lock">Mantener el dispositivo activo: para completar la comprobación diaria.</string>
    <string name="about_perm_receiver">Permiso interno de Formica: impide que otras aplicaciones envíen mensajes a las partes internas de Formica y no da acceso a ningún dato. Se necesita hasta Android 12; las versiones posteriores ofrecen la misma protección por sí solas y el permiso no se usa.</string>
