    <string name="welcome_title">Te damos la bienvenida a Formica</string>
    <string name="welcome_text">La despensa y la lista de la compra de casa. Funciona sin internet y sin cuenta: tus datos se quedan en el teléfono.</string>
    <string name="welcome_notification">Notificación diaria de caducidades</string>
    <string name="welcome_notification_hint">A las %1$s, solo si algo caduca o está listo. Puedes cambiarlo en Ajustes.</string>
    <string name="welcome_initial_data">Las ubicaciones y las categorías ya están listas: puedes cambiarlas en Ajustes.</string>
