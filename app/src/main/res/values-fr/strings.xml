    <string name="welcome_title">Bienvenue dans Formica</string>
    <string name="welcome_text">Le garde-manger et la liste de courses de la maison. Fonctionne sans internet et sans compte : vos données restent sur le téléphone.</string>
    <string name="welcome_notification">Notification quotidienne des dates limites</string>
